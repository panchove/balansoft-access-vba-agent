# Credenciales para las pruebas de integración contra Nvidia NIM.
# Copia este archivo a ".env" en la raíz del repo y rellena el valor.
#
#   copy .env.example .env
#
# El archivo ".env" está en .gitignore: no lo subas nunca.

# Clave de API de Nvidia NIM (https://build.nvidia.com).
NIM_API_KEY=

# Modelo a usar en las pruebas de integración.
# Si lo dejas vacío se usa el de producción: nvidia/nemotron-3-ultra-550b-a55b
#
# Puedes listar los modelos disponibles con:
#   curl https://integrate.api.nvidia.com/v1/models
NIM_MODEL=

# Opcional: sobrescribe el endpoint (por defecto el de producción).
NIM_ENDPOINT=

# Nivel de razonamiento del modelo: default | low | medium | high
# Si lo dejas vacío se usa BlsConstants.NimReasoningEffort ("default").
# Un valor fuera de esta lista se ignora y se usa "default".
NIM_REASONING_EFFORT=low

# Idioma de las respuestas del modelo: english | spanish
# También se aceptan las abreviaturas en/es. Si está vacío se usa
# BlsConstants.NimDefaultLanguage ("english").
NIM_DEFAULT_LANGUAGE=english
